;; ============================================================================
;; Machine Downtime & Item Issue Tracker  --  TallyPrime TDL Add-On
;; ============================================================================
;; Purpose : Adds machine-wise stock item issue tracking and machine downtime
;;           logging to TallyPrime, with dedicated registers/reports.
;;
;; Modules :
;;   1. UDF (User Defined Field) declarations
;;   2. Machine master (built on Cost Centre, category "Machines")
;;   3. Voucher Type : Machine Item Issue      (based on Stock Journal)
;;   4. Voucher Type : Machine Downtime Entry  (based on Journal, memo ledger)
;;   5. Collections used by the reports below
;;   6. Report : Machine Item Issue Register
;;   7. Report : Machine Downtime Report
;;   8. Gateway of Tally menu integration
;;
;; See README.md in this repository for installation, one-time setup
;; (Cost Category, memo ledger, Zero-Valued Transactions) and troubleshooting.
;; ============================================================================


;; ----------------------------------------------------------------------------
;; 1. UDF DECLARATIONS
;; ----------------------------------------------------------------------------
;; Field numbers use the 9061-9069 custom range. If another TDL already loaded
;; on the target Tally instance uses the same numbers, renumber this block.

[System: UDF]
	MIIMachineName     : String : 9061
	MIIIssueReason     : String : 9062
	MIIRemarks         : String : 9063
	MDEMachineName     : String : 9064
	MDEFromTime        : String : 9065
	MDEToTime          : String : 9066
	MDEDurationMinutes : Number : 9067
	MDEReason          : String : 9068
	MDERemarks         : String : 9069


;; ----------------------------------------------------------------------------
;; 2. MACHINE MASTER
;; ----------------------------------------------------------------------------
;; Machines are represented as Cost Centres under a dedicated Cost Category
;; called "Machines" (create this once, see README). This re-uses Tally's
;; native master screens (Create/Alter/Display). Convention:
;;    Cost Centre Name   -> Machine Name (e.g. "CNC Lathe 01")
;;    Cost Centre Alias  -> Machine Code (e.g. "CNC-01")
;;    Parent Cost Centre -> Department / Shop Floor Area (optional hierarchy)

[System: Formula]
	IsMachineCC          : $Category = "Machines"
	IsMachineIssueVch    : $VoucherTypeName = "Machine Item Issue"
	IsMachineDowntimeVch : $VoucherTypeName = "Machine Downtime Entry"

[Collection: Machine Cost Centres]
	Type   : Cost Centre
	Fetch  : Name, Category, Parent
	Filter : IsMachineCC

[#Menu: Gateway of Tally]
	Add : Item : Machine Reports : Menu : Machine Reports Menu


;; ----------------------------------------------------------------------------
;; 3. VOUCHER TYPE: MACHINE ITEM ISSUE  (Parent: Stock Journal)
;; ----------------------------------------------------------------------------
;; Used to issue stock items for consumption at a specific machine. Record
;; the items under "Source (Consumption)"; leave "Destination" empty since
;; there is no manufactured output being tracked here. The Machine field
;; applies to the whole voucher (one machine per issue voucher), and is
;; captured just above the Narration during voucher entry.
;;
;; ONE-TIME SETUP REQUIRED (see README): voucher types are Tally data
;; masters and cannot be created from TDL. Create a voucher type named
;; exactly "Machine Item Issue" with Type of Voucher = Stock Journal.

[Field: MII Machine Field]
	Use     : Name Field
	Set as  : $MIIMachineName
	Storage : MIIMachineName
	Table   : Machine Cost Centres
	Width   : 25

[Field: MII Reason Field]
	Use     : Name Field
	Set as  : $MIIIssueReason
	Storage : MIIIssueReason
	Width   : 25

[Field: MIIRemarks Field]
	Use     : Name Field
	Set as  : $MIIRemarks
	Storage : MIIRemarks
	Width   : 25

[Field: MII Machine Prompt]
	Use    : Medium Prompt
	Set as : "Machine : "

[Field: MII Reason Prompt]
	Use    : Medium Prompt
	Set as : "Issue Reason : "

[Field: MIIRemarks Prompt]
	Use    : Medium Prompt
	Set as : "Remarks : "

[Line: MII Machine Line]
	Fields    : MII Machine Prompt, MII Machine Field
	Invisible : NOT @@IsMachineIssueVch

[Line: MII Reason Line]
	Fields    : MII Reason Prompt, MII Reason Field
	Invisible : NOT @@IsMachineIssueVch

[Line: MIIRemarks Line]
	Fields    : MIIRemarks Prompt, MIIRemarks Field
	Invisible : NOT @@IsMachineIssueVch

;; VCH Narration is the standard narration Part/Line of the voucher entry
;; screen in TallyPrime's default TDL; new lines for both voucher types are
;; anchored before it in a single modifier block at the end of section 4.


;; ----------------------------------------------------------------------------
;; 4. VOUCHER TYPE: MACHINE DOWNTIME ENTRY  (Parent: Journal)
;; ----------------------------------------------------------------------------
;; A lightweight, non-financial log of machine downtime. Built on Journal so
;; it gets standard numbering, alteration, and Day Book visibility for free.
;; Post a self-offsetting Rs.0 Dr/Cr entry to the dedicated memo ledger
;; "Machine Downtime (Memo)" so it never affects real books.
;;
;; ONE-TIME SETUP REQUIRED (see README):
;;   - Voucher type named exactly "Machine Downtime Entry" with
;;     Type of Voucher = Journal (voucher types are Tally data masters
;;     and cannot be created from TDL)
;;   - Ledger "Machine Downtime (Memo)" under group "Suspense Account"
;;   - F11 > Allow Zero-Valued Transactions = Yes

[Field: MDE Machine Field]
	Use     : Name Field
	Set as  : $MDEMachineName
	Storage : MDEMachineName
	Table   : Machine Cost Centres
	Width   : 25

[Field: MDEFromTime Field]
	Use     : Name Field
	Set as  : $MDEFromTime
	Storage : MDEFromTime
	Width   : 10

[Field: MDEToTime Field]
	Use     : Name Field
	Set as  : $MDEToTime
	Storage : MDEToTime
	Width   : 10

[Field: MDE Duration Field]
	Use     : Number Field
	Set as  : $MDEDurationMinutes
	Storage : MDEDurationMinutes
	Width   : 10

[Field: MDEReason Field]
	Use     : Name Field
	Set as  : $MDEReason
	Storage : MDEReason
	Width   : 25

[Field: MDERemarks Field]
	Use     : Name Field
	Set as  : $MDERemarks
	Storage : MDERemarks
	Width   : 25

[Field: MDE Machine Prompt]
	Use    : Medium Prompt
	Set as : "Machine : "

[Field: MDEFromTime Prompt]
	Use    : Medium Prompt
	Set as : "From (HH:MM) : "

[Field: MDEToTime Prompt]
	Use    : Medium Prompt
	Set as : "To (HH:MM) : "

[Field: MDE Duration Prompt]
	Use    : Medium Prompt
	Set as : "Duration (Min) : "

[Field: MDEReason Prompt]
	Use    : Medium Prompt
	Set as : "Downtime Reason : "

[Field: MDERemarks Prompt]
	Use    : Medium Prompt
	Set as : "Remarks : "

[Line: MDE Machine Line]
	Fields    : MDE Machine Prompt, MDE Machine Field
	Invisible : NOT @@IsMachineDowntimeVch

[Line: MDE Time Line]
	Fields    : MDEFromTime Prompt, MDEFromTime Field, MDEToTime Prompt, MDEToTime Field, MDE Duration Prompt, MDE Duration Field
	Invisible : NOT @@IsMachineDowntimeVch

[Line: MDEReason Line]
	Fields    : MDEReason Prompt, MDEReason Field
	Invisible : NOT @@IsMachineDowntimeVch

[Line: MDERemarks Line]
	Fields    : MDERemarks Prompt, MDERemarks Field
	Invisible : NOT @@IsMachineDowntimeVch

[#Part: VCH Narration]
	Add : Line : Before : VCH Narration : MII Machine Line, MII Reason Line, MIIRemarks Line
	Add : Line : Before : VCH Narration : MDE Machine Line, MDE Time Line, MDEReason Line, MDERemarks Line


;; ----------------------------------------------------------------------------
;; 5. COLLECTIONS FOR REPORTS
;; ----------------------------------------------------------------------------

[Collection: MII Vouchers]
	Type   : Voucher
	Filter : IsMachineIssueVch
	Fetch  : Date, VoucherNumber, VoucherTypeName, MIIMachineName, MIIIssueReason, MIIRemarks, AllInventoryEntries.*

[Collection: MII Inventory Lines]
	Source Collection : MII Vouchers
	Walk              : AllInventoryEntries
	Fetch             : StockItemName, ActualQty, Rate, Amount
	Compute           : VchDate    : $Date
	Compute           : VchNumber  : $VoucherNumber
	Compute           : VchMachine : $MIIMachineName
	Compute           : VchReason  : $MIIIssueReason

[Collection: MDE Vouchers]
	Type   : Voucher
	Filter : IsMachineDowntimeVch
	Fetch  : Date, VoucherNumber, VoucherTypeName, MDEMachineName, MDEFromTime, MDEToTime, MDEDurationMinutes, MDEReason, MDERemarks


;; ----------------------------------------------------------------------------
;; 6. REPORT: MACHINE ITEM ISSUE REGISTER
;; ----------------------------------------------------------------------------

[Report: Machine Item Issue Register]
	Form  : MII Register Form
	Title : "Machine Item Issue Register"

[Form: MII Register Form]
	Part   : MII Register Part
	Width  : 100% Screen
	Height : 100% Screen

[Part: MII Register Part]
	Line   : MII Register Title Line, MII Register Detail Line
	Repeat : MII Register Detail Line : MII Inventory Lines
	Scroll : Vertical

[Line: MII Register Title Line]
	Use    : MII Register Detail Line
	Local  : Field : MII Col Date    : Set as : "Date"
	Local  : Field : MII Col VchNo   : Set as : "Vch No"
	Local  : Field : MII Col Machine : Set as : "Machine"
	Local  : Field : MII Col Item    : Set as : "Item Name"
	Local  : Field : MII Col Qty     : Set as : "Qty"
	Local  : Field : MII Col Rate    : Set as : "Rate"
	Local  : Field : MII Col Amount  : Set as : "Value"
	Local  : Field : MII Col Reason  : Set as : "Reason"
	Border : Thin Top Bottom

[Line: MII Register Detail Line]
	Fields : MII Col Date, MII Col VchNo, MII Col Machine, MII Col Item, MII Col Qty, MII Col Rate, MII Col Amount, MII Col Reason

[Field: MII Col Date]
	Use    : Name Field
	Set as : $VchDate
	Width  : 10

[Field: MII Col VchNo]
	Use    : Name Field
	Set as : $VchNumber
	Width  : 8

[Field: MII Col Machine]
	Use    : Name Field
	Set as : $VchMachine
	Width  : 20

[Field: MII Col Item]
	Use    : Name Field
	Set as : $StockItemName
	Width  : 24

[Field: MII Col Qty]
	Use    : Name Field
	Set as : $ActualQty
	Width  : 12
	Align  : Right

[Field: MII Col Rate]
	Use    : Name Field
	Set as : $Rate
	Width  : 12
	Align  : Right

[Field: MII Col Amount]
	Use    : Name Field
	Set as : $Amount
	Width  : 12
	Align  : Right

[Field: MII Col Reason]
	Use    : Name Field
	Set as : $VchReason
	Width  : 16


;; ----------------------------------------------------------------------------
;; 7. REPORT: MACHINE DOWNTIME REPORT
;; ----------------------------------------------------------------------------
;; Chronological register of every downtime entry. For a machine-wise rollup
;; (total minutes per machine), export to Excel (Alt+E) and pivot there, or
;; extend with a Group By collection tuned to your TallyPrime release.

[Report: Machine Downtime Report]
	Form  : MDE Report Form
	Title : "Machine Downtime Report"

[Form: MDE Report Form]
	Part   : MDE Report Part
	Width  : 100% Screen
	Height : 100% Screen

[Part: MDE Report Part]
	Line   : MDE Report Title Line, MDE Report Detail Line
	Repeat : MDE Report Detail Line : MDE Vouchers
	Scroll : Vertical

[Line: MDE Report Title Line]
	Use    : MDE Report Detail Line
	Local  : Field : MDE Col Date    : Set as : "Date"
	Local  : Field : MDE Col VchNo   : Set as : "Vch No"
	Local  : Field : MDE Col Machine : Set as : "Machine"
	Local  : Field : MDE Col From    : Set as : "From"
	Local  : Field : MDE Col To      : Set as : "To"
	Local  : Field : MDE Col Minutes : Set as : "Minutes"
	Local  : Field : MDE Col Reason  : Set as : "Reason"
	Local  : Field : MDE Col Remarks : Set as : "Remarks"
	Border : Thin Top Bottom

[Line: MDE Report Detail Line]
	Fields : MDE Col Date, MDE Col VchNo, MDE Col Machine, MDE Col From, MDE Col To, MDE Col Minutes, MDE Col Reason, MDE Col Remarks

[Field: MDE Col Date]
	Use    : Name Field
	Set as : $Date
	Width  : 10

[Field: MDE Col VchNo]
	Use    : Name Field
	Set as : $VoucherNumber
	Width  : 8

[Field: MDE Col Machine]
	Use    : Name Field
	Set as : $MDEMachineName
	Width  : 20

[Field: MDE Col From]
	Use    : Name Field
	Set as : $MDEFromTime
	Width  : 8

[Field: MDE Col To]
	Use    : Name Field
	Set as : $MDEToTime
	Width  : 8

[Field: MDE Col Minutes]
	Use    : Name Field
	Set as : $MDEDurationMinutes
	Width  : 8
	Align  : Right

[Field: MDE Col Reason]
	Use    : Name Field
	Set as : $MDEReason
	Width  : 18

[Field: MDE Col Remarks]
	Use    : Name Field
	Set as : $MDERemarks
	Width  : 18


;; ----------------------------------------------------------------------------
;; 8. GATEWAY OF TALLY MENU
;; ----------------------------------------------------------------------------

[Menu: Machine Reports Menu]
	Title : "Machine Reports"
	Item  : Machine Item Issue Register : Display : Machine Item Issue Register
	Item  : Machine Downtime Report     : Display : Machine Downtime Report

;; ============================================================================
;; END OF FILE
;; ============================================================================
