*  ============================================================================
*  Machine Downtime & Item Issue Tracker  --  TallyPrime TDL Add-On
*  ============================================================================
*  Purpose : Adds machine-wise stock item issue tracking and machine downtime
*            logging to TallyPrime, with dedicated registers/reports.
*
*  Modules :
*    1. UDF (User Defined Field) declarations
*    2. Machine master (built on Cost Centre, category "Machines")
*    3. Voucher Type : Machine Item Issue      (based on Stock Journal)
*    4. Voucher Type : Machine Downtime Entry  (based on Journal, memo ledger)
*    5. Collections used by the reports below
*    6. Report : Machine Item Issue Register
*    7. Report : Machine Downtime Report
*    8. Gateway of Tally menu integration
*
*  See README.md in this repository for installation, one-time setup
*  (Cost Category, memo ledger, Zero-Valued Transactions) and troubleshooting.
*  ============================================================================


*  ----------------------------------------------------------------------------
*  1. UDF DECLARATIONS
*  ----------------------------------------------------------------------------
*  Field numbers use the 9060-9080 custom range. If another TDL already loaded
*  on the target Tally instance uses the same numbers, renumber this block.

[System: UDF]
	MII_MachineName      : String  : 9061
	MII_IssueReason      : String  : 9062
	MII_Remarks          : String  : 9063

	MDE_MachineName      : String  : 9064
	MDE_FromTime         : String  : 9065
	MDE_ToTime            : String  : 9066
	MDE_DurationMinutes  : Number  : 9067
	MDE_Reason           : String  : 9068
	MDE_Remarks          : String  : 9069


*  ----------------------------------------------------------------------------
*  2. MACHINE MASTER
*  ----------------------------------------------------------------------------
*  Machines are represented as Cost Centres under a dedicated Cost Category
*  called "Machines" (create this once, see README). This re-uses Tally's
*  native master screens (Create/Alter/Display) instead of a bespoke object,
*  which keeps this add-on small and reliable. Convention:
*     Cost Centre Name  -> Machine Name   (e.g. "CNC Lathe 01")
*     Cost Centre Alias -> Machine Code   (e.g. "CNC-01")
*     Parent Cost Centre-> Department / Shop Floor Area (optional hierarchy)

[System: Formulae]
	Is Machine Cost Centre    : $Category = "Machines"
	Is Machine Item Issue Vch : $$VoucherTypeName = "Machine Item Issue"
	Is Machine Downtime Vch   : $$VoucherTypeName = "Machine Downtime Entry"

[Collection: Machine Cost Centres]
	Type       : Cost Centre
	Fetch      : Name, Alias, Category, Parent
	Filter     : Is Machine Cost Centre
	Sort       : Default

;  Convenience Gateway shortcuts so operators don't need to know the
;  underlying Cost Centre / Cost Category mechanics.

[#Menu: Gateway of Tally]
	Add : Item : Create Machine   : Create : Cost Centre
	Add : Item : Machine Reports  : Menu    : Machine Reports Menu


*  ----------------------------------------------------------------------------
*  3. VOUCHER TYPE: MACHINE ITEM ISSUE  (Parent: Stock Journal)
*  ----------------------------------------------------------------------------
*  Used to issue stock items for consumption at a specific machine. Record
*  the items under "Source (Consumption)"; leave "Destination" empty since
*  there is no manufactured output being tracked here. The Machine field
*  applies to the whole voucher (one machine per issue voucher).

[Voucher Type: Machine Item Issue]
	Parent               : Stock Journal
	Numbering Method     : Automatic
	Use Common Narration : Yes
	Restart Numbering    : Yes
	Starting Number      : 1

[Field: Machine Issue - Machine Name Field]
	Set as    : $MII_MachineName
	Storage   : MII_MachineName
	Table     : Machine Cost Centres
	Width     : 30
	Info Line : "Machine to which these items are being issued"

[Field: Machine Issue - Reason Field]
	Set as    : $MII_IssueReason
	Storage   : MII_IssueReason
	Width     : 30
	Info Line : "Reason for issue, e.g. Production, Maintenance, Trial Run"

[Field: Machine Issue - Remarks Field]
	Set as  : $MII_Remarks
	Storage : MII_Remarks
	Width   : 30

[Line: Machine Issue Details Line]
	Option : Is Machine Item Issue Vch
	Fields : Machine Issue - Machine Name Field, Machine Issue - Reason Field, Machine Issue - Remarks Field

[#Part: Voucher Type Sub Form]
	Add : Line : Machine Issue Details Line : Before : Field : Narration Field


*  ----------------------------------------------------------------------------
*  4. VOUCHER TYPE: MACHINE DOWNTIME ENTRY  (Parent: Journal)
*  ----------------------------------------------------------------------------
*  A lightweight, non-financial log of machine downtime. Built on Journal so
*  it gets standard numbering, alteration, and Day Book visibility for free.
*  It posts a self-offsetting Rs.0 entry to a dedicated memo ledger so it
*  never affects real books.
*
*  ONE-TIME SETUP REQUIRED (see README):
*    - Ledger "Machine Downtime (Memo)" under group "Suspense Account"
*    - F11/F12 > Voucher Entry > "Allow Zero-Valued Transactions" = Yes

[Voucher Type: Machine Downtime Entry]
	Parent               : Journal
	Numbering Method     : Automatic
	Use Common Narration : Yes
	Restart Numbering    : Yes
	Starting Number      : 1

[Field: Downtime - Machine Name Field]
	Set as    : $MDE_MachineName
	Storage   : MDE_MachineName
	Table     : Machine Cost Centres
	Width     : 30
	Info Line : "Machine that experienced downtime"

[Field: Downtime - From Time Field]
	Set as    : $MDE_FromTime
	Storage   : MDE_FromTime
	Width     : 10
	Info Line : "Downtime start, 24-hr HH:MM, e.g. 14:30"

[Field: Downtime - To Time Field]
	Set as    : $MDE_ToTime
	Storage   : MDE_ToTime
	Width     : 10
	Info Line : "Downtime end, 24-hr HH:MM, e.g. 15:10"

[Field: Downtime - Duration Field]
	Set as    : $MDE_DurationMinutes
	Storage   : MDE_DurationMinutes
	Width     : 10
	Info Line : "Total downtime in minutes"

[Field: Downtime - Reason Field]
	Set as    : $MDE_Reason
	Storage   : MDE_Reason
	Width     : 30
	Info Line : "e.g. Breakdown, Preventive Maintenance, Power Failure, Material Shortage, Changeover, Operator Unavailable"

[Field: Downtime - Remarks Field]
	Set as  : $MDE_Remarks
	Storage : MDE_Remarks
	Width   : 30

[Line: Machine Downtime Details Line]
	Option : Is Machine Downtime Vch
	Fields : Downtime - Machine Name Field, Downtime - From Time Field, Downtime - To Time Field, Downtime - Duration Field, Downtime - Reason Field, Downtime - Remarks Field

[#Part: Voucher Type Sub Form]
	Add : Line : Machine Downtime Details Line : Before : Field : Narration Field

;  Pre-fill both ledger legs with the dedicated memo ledger at Rs.0, so the
;  operator only has to press Enter through the accounting section.
[#Field: Ledger Name Field]
	Option : Is Machine Downtime Vch
	Set as : "Machine Downtime (Memo)"

[#Field: Amount Field]
	Option : Is Machine Downtime Vch
	Set as : 0


*  ----------------------------------------------------------------------------
*  5. COLLECTIONS FOR REPORTS
*  ----------------------------------------------------------------------------

[Collection: Machine Item Issue Vouchers]
	Type    : Voucher
	Fetch   : Date, VoucherNumber, MII_MachineName, MII_IssueReason, MII_Remarks, AllInventoryEntries.*
	Filter  : Is Machine Item Issue Vch
	Sort    : Date

[Collection: Machine Item Issue Lines]
	Source Collection : Machine Item Issue Vouchers
	Walk               : AllInventoryEntries
	Fetch              : StockItemName, ActualQty, BilledQty, Rate, Amount

[Collection: Machine Downtime Vouchers]
	Type    : Voucher
	Fetch   : Date, VoucherNumber, MDE_MachineName, MDE_FromTime, MDE_ToTime, MDE_DurationMinutes, MDE_Reason, MDE_Remarks
	Filter  : Is Machine Downtime Vch
	Sort    : Date


*  ----------------------------------------------------------------------------
*  6. REPORT: MACHINE ITEM ISSUE REGISTER
*  ----------------------------------------------------------------------------

[Report: Machine Item Issue Register]
	Form   : Machine Item Issue Register Form
	Title  : "Machine Item Issue Register"

[Form: Machine Item Issue Register Form]
	Part   : Machine Item Issue Register Part

[Part: Machine Item Issue Register Part]
	Line    : Machine Item Issue Register Header, Machine Item Issue Register Body
	Repeat  : Machine Item Issue Register Body : Machine Item Issue Lines
	Scroll  : Vertical

[Line: Machine Item Issue Register Header]
	Fields    : Header - Date, Header - VchNo, Header - Machine, Header - Item, Header - Qty, Header - Rate, Header - Value, Header - Reason
	Local     : Field : Header - Date   : Set as : "Date"
	Local     : Field : Header - VchNo  : Set as : "Vch No"
	Local     : Field : Header - Machine: Set as : "Machine"
	Local     : Field : Header - Item   : Set as : "Item Name"
	Local     : Field : Header - Qty    : Set as : "Qty"
	Local     : Field : Header - Rate   : Set as : "Rate"
	Local     : Field : Header - Value  : Set as : "Value"
	Local     : Field : Header - Reason : Set as : "Reason"

[Line: Machine Item Issue Register Body]
	Fields : Body - Date, Body - VchNo, Body - Machine, Body - Item, Body - Qty, Body - Rate, Body - Value, Body - Reason

[Field: Header - Date]
	Type   : String
	Width  : 12

[Field: Header - VchNo]
	Type   : String
	Width  : 10

[Field: Header - Machine]
	Type   : String
	Width  : 20

[Field: Header - Item]
	Type   : String
	Width  : 24

[Field: Header - Qty]
	Type   : String
	Width  : 10

[Field: Header - Rate]
	Type   : String
	Width  : 10

[Field: Header - Value]
	Type   : String
	Width  : 12

[Field: Header - Reason]
	Type   : String
	Width  : 18

[Field: Body - Date]
	Set as : $Date
	Width  : 12

[Field: Body - VchNo]
	Set as : $VoucherNumber
	Width  : 10

[Field: Body - Machine]
	Set as : $MII_MachineName
	Width  : 20

[Field: Body - Item]
	Set as : $StockItemName
	Width  : 24

[Field: Body - Qty]
	Set as : $ActualQty
	Width  : 10

[Field: Body - Rate]
	Set as : $Rate
	Width  : 10

[Field: Body - Value]
	Set as : $Amount
	Width  : 12

[Field: Body - Reason]
	Set as : $MII_IssueReason
	Width  : 18


*  ----------------------------------------------------------------------------
*  7. REPORT: MACHINE DOWNTIME REPORT
*  ----------------------------------------------------------------------------
*  Detailed, chronological register of every downtime entry. To roll this up
*  machine-wise (total minutes per machine, event counts, etc.) use Tally's
*  built-in Export to Excel from this report and summarise there, since the
*  exact aggregate-function names differ across Tally releases and are best
*  verified/tuned against the target installation. See README for pointers on
*  extending this report with a native machine-wise summary Part.

[Report: Machine Downtime Report]
	Form  : Machine Downtime Report Form
	Title : "Machine Downtime Report"

[Form: Machine Downtime Report Form]
	Part : Machine Downtime Detail Part

[Part: Machine Downtime Detail Part]
	Line    : Downtime Detail Header, Downtime Detail Body
	Repeat  : Downtime Detail Body : Machine Downtime Vouchers
	Scroll  : Vertical

[Line: Downtime Detail Header]
	Fields : DH - Date, DH - VchNo, DH - Machine, DH - From, DH - To, DH - Minutes, DH - Reason, DH - Remarks
	Local  : Field : DH - Date    : Set as : "Date"
	Local  : Field : DH - VchNo   : Set as : "Vch No"
	Local  : Field : DH - Machine : Set as : "Machine"
	Local  : Field : DH - From    : Set as : "From"
	Local  : Field : DH - To      : Set as : "To"
	Local  : Field : DH - Minutes : Set as : "Minutes"
	Local  : Field : DH - Reason  : Set as : "Reason"
	Local  : Field : DH - Remarks : Set as : "Remarks"

[Line: Downtime Detail Body]
	Fields : DB - Date, DB - VchNo, DB - Machine, DB - From, DB - To, DB - Minutes, DB - Reason, DB - Remarks

[Field: DH - Date]
	Type  : String
	Width : 12

[Field: DH - VchNo]
	Type  : String
	Width : 10

[Field: DH - Machine]
	Type  : String
	Width : 20

[Field: DH - From]
	Type  : String
	Width : 8

[Field: DH - To]
	Type  : String
	Width : 8

[Field: DH - Minutes]
	Type  : String
	Width : 10

[Field: DH - Reason]
	Type  : String
	Width : 20

[Field: DH - Remarks]
	Type  : String
	Width : 20

[Field: DB - Date]
	Set as : $Date
	Width  : 12

[Field: DB - VchNo]
	Set as : $VoucherNumber
	Width  : 10

[Field: DB - Machine]
	Set as : $MDE_MachineName
	Width  : 20

[Field: DB - From]
	Set as : $MDE_FromTime
	Width  : 8

[Field: DB - To]
	Set as : $MDE_ToTime
	Width  : 8

[Field: DB - Minutes]
	Set as : $MDE_DurationMinutes
	Width  : 10

[Field: DB - Reason]
	Set as : $MDE_Reason
	Width  : 20

[Field: DB - Remarks]
	Set as : $MDE_Remarks
	Width  : 20


*  ----------------------------------------------------------------------------
*  8. GATEWAY OF TALLY MENU
*  ----------------------------------------------------------------------------

[Menu: Machine Reports Menu]
	Title : "Machine Reports"
	Item  : Machine Item Issue Register : Display : Machine Item Issue Register
	Item  : Machine Downtime Report     : Display : Machine Downtime Report
	Item  : Create Machine (Cost Centre): Create   : Cost Centre

*  ============================================================================
*  END OF FILE
*  ============================================================================
